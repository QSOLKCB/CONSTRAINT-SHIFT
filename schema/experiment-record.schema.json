{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/CONSTRAINT-SHIFT/schema/experiment-record.schema.json",
  "title": "CONSTRAINT-SHIFT experiment record",
  "description": "Version 1.0.0 machine-readable record for retained CONSTRAINT-SHIFT experimental evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "created_at",
    "hypotheses",
    "task",
    "agent",
    "language",
    "toolchain",
    "environment",
    "predeclared",
    "trial",
    "interventions",
    "verification_outcomes",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "constraint-shift-experiment"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "H1",
          "H2",
          "H3",
          "H4",
          "H5",
          "H6"
        ]
      }
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "toolchain": {
      "$ref": "#/$defs/toolchain"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "predeclared": {
      "$ref": "#/$defs/predeclared"
    },
    "trial": {
      "$ref": "#/$defs/trial"
    },
    "interventions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intervention"
      }
    },
    "verification_outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "equivalence_group",
        "specification_ref",
        "acceptance_ref"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "equivalence_group": {
          "type": "string",
          "minLength": 1
        },
        "specification_ref": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "kind",
        "name"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "ai",
            "human",
            "scripted",
            "none"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "instructions_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_or_runtime",
        "build_flags",
        "dependencies",
        "analysis_tools"
      ],
      "properties": {
        "compiler_or_runtime": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependency_lock_ref": {
          "type": "string",
          "minLength": 1
        },
        "test_command": {
          "type": "string",
          "minLength": 1
        },
        "analysis_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "hardware_summary": {
          "type": "string",
          "minLength": 1
        },
        "container_image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "predeclared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experimental_unit",
        "acceptance_criteria",
        "resource_limits",
        "stopping_rule",
        "inclusion_rule",
        "exclusion_rule",
        "invalid_trial_rule",
        "timeout_rule",
        "missing_data_rule",
        "primary_denominators"
      ],
      "properties": {
        "experimental_unit": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resource_limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stopping_rule": {
          "type": "string",
          "minLength": 1
        },
        "inclusion_rule": {
          "type": "string",
          "minLength": 1
        },
        "exclusion_rule": {
          "type": "string",
          "minLength": 1
        },
        "invalid_trial_rule": {
          "type": "string",
          "minLength": 1
        },
        "timeout_rule": {
          "type": "string",
          "minLength": 1
        },
        "missing_data_rule": {
          "type": "string",
          "minLength": 1
        },
        "primary_denominators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "attempt",
        "condition",
        "factors",
        "started_at",
        "ended_at",
        "status",
        "termination_reason",
        "measurements"
      ],
      "properties": {
        "trial_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "factors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/factor"
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "invalid",
            "timeout",
            "aborted"
          ]
        },
        "termination_reason": {
          "type": "string",
          "minLength": 1
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measurement"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "actor",
        "kind",
        "description",
        "evidence_refs"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "tool"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_id",
        "kind",
        "status",
        "independent_from_generator",
        "command",
        "evidence_refs"
      ],
      "properties": {
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "compile",
            "test",
            "static",
            "formal",
            "behavioural",
            "manual",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "error",
            "not_run"
          ]
        },
        "independent_from_generator": {
          "type": "boolean"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "path",
        "sha256",
        "media_type"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "input",
            "output",
            "log",
            "diff",
            "build",
            "test",
            "static",
            "formal",
            "measurement",
            "environment",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
